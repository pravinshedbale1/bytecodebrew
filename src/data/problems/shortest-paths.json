{"slug":"path-with-maximum-probability","title":"Path with Maximum Probability","level":"Medium","summary":"Each undirected edge succeeds with probability succProb[i]. Return the highest probability of a path from start_node to end_node (0 if none). Answers within 10^-5 are accepted.","method":"maxProbability","params":[["int","n"],["int[][]","edges"],["double[]","succProb"],["int","start_node"],["int","end_node"]],"returns":"double","tests":[{"in":["3","[[0,1],[1,2],[0,2]]","[0.5,0.5,0.2]","0","2"],"out":"0.25"},{"in":["3","[[0,1],[1,2],[0,2]]","[0.5,0.5,0.3]","0","2"],"out":"0.3"},{"in":["3","[[0,1]]","[0.5]","0","2"],"out":"0.0"},{"in":["4","[[0,1],[1,3],[0,2],[2,3]]","[0.9,0.9,0.5,1]","0","3"],"out":"0.81"},{"in":["2","[[0,1]]","[0.32]","1","0"],"out":"0.32","g":1},{"in":["2","[[0,1]]","[0]","1","0"],"out":"0.0","g":1},{"in":["4","[[1,2]]","[1]","1","2"],"out":"1.0","g":1},{"in":["3","[[0,2],[1,0]]","[0,0.5]","0","2"],"out":"0.0","g":1},{"in":["7","[]","[]","1","2"],"out":"0.0","g":1},{"in":["2","[[0,1]]","[1]","0","1"],"out":"1.0","g":1},{"in":["2","[[1,0]]","[1]","1","0"],"out":"1.0","g":1},{"in":["7","[[0,1],[5,4]]","[0.5,1]","2","6"],"out":"0.0","g":1},{"in":["6","[[4,0],[4,1],[3,5],[5,2],[0,3],[2,1],[3,1],[0,2],[1,0],[5,0],[5,4],[2,3]]","[0.5,0.7759,1,0.33,0.2149,0.5,1,0.21,0.5,0.95,0.244,0]","1","3"],"out":"1.0","g":1},{"in":["3","[]","[]","1","2"],"out":"0.0","g":1},{"in":["6","[[0,4],[2,0],[1,2],[3,5],[2,3],[4,1],[1,3],[4,5]]","[0,0.3338,0.22,0.599,0.5,0.5,0.09,1]","2","1"],"out":"0.22","g":1},{"in":["2","[[1,0]]","[0.7509]","0","1"],"out":"0.7509","g":1},{"in":["10","[[5,9],[0,7],[0,8],[3,7],[2,1],[5,7],[6,9],[9,4],[9,1],[6,7],[8,5],[2,5]]","[0.5,1,0.5,0,0.8,0,0,0.8694,0,0,0.5,1]","4","0"],"out":"0.108675","g":1},{"in":["2","[[0,1]]","[0.33]","0","1"],"out":"0.33","g":1},{"in":["9","[[1,7],[8,5],[7,2]]","[0.97,1,0.6508]","3","0"],"out":"0.0","g":1},{"in":["9","[[4,1],[0,5],[1,5],[8,0],[7,4]]","[0,0,0.0419,0.9622,0.5]","1","8"],"out":"0.0","g":1},{"in":[