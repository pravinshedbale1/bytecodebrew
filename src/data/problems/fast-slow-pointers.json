{"slug":"linked-list-cycle-ii","title":"Linked List Cycle II","level":"Medium","summary":"Return the node where the cycle begins, or null if there is no cycle, without modifying the list. The judge prints that node's index (-1 for null). Tests give the list and the tail's link position.","method":"detectCycle","params":[["ListNode","head"],["int","pos"]],"starterParams":[["ListNode","head"]],"returns":"ListNode","call":"ListNode h = BCBN.cycle($0, BCB.I($1)); ListNode c = s.detectCycle(h); Object r = c == null ? -1 : BCBN.indexOf(h, c);","tests":[{"in":["[3,2,0,-4]","1"],"out":"1"},{"in":["[1,2]","0"],"out":"0"},{"in":["[1]","-1"],"out":"-1"},{"in":["[1,2,3,4,5,6]","3"],"out":"3"},{"in":["[1,2,3]","2"],"out":"2"},{"in":["[]","-1"],"out":"-1","g":1},{"in":["[-16490,100000,-1,1091]","3"],"out":"3","g":1},{"in":["[-100000,-100000,13232]","2"],"out":"2","g":1},{"in":["[91427,91427,-34191,-34191,-34191,91427,-34191,91427,-34191,-34191]","-1"],"out":"-1","g":1},{"in":["[-58909,57650,-46940,100000,-12589,-48361,100000]","-1"],"out":"-1","g":1},{"in":["[41832]","0"],"out":"0","g":1},{"in":["[16846,16846]","0"],"out":"0","g":1},{"in":["[1,1,1]","0"],"out":"0","g":1},{"in":["[-55439]","0"],"out":"0","g":1},{"in":["[1,-35317,-13481,100000,-59996,43729,2769,79086,-87,-100000]","0"],"out":"0","g":1},{"in":["[100000,-6950,-100000,93356,86102,-38141,15777,66904]","0"],"out":"0","g":1},{"in":["[-12865,-12865,-12865,-12865,-12865,-12865,-12865,-12866,-12866,-12866,-12867,-12867,-12867,-12868,-12868,-12868,-12869]","0"],"out":"0","g":1},{"in":["[78956,-53153]","1"],"out":"1","g":1},{"in":["[-15743]","0"],"out":"0","g":1},{"in":["[-100000,96697,37016,-19610,-214,93294,59897,-95513,100000,-100000]","-1"],"out":"-1","g":1},{"in":["[82368,82369]","0"],"out":"0","g":1},{"in":["[-55957,-55959,-55960,-55961,-55962,-55962,-55963]","6"],"out":"6","g":1},{"in":["[-45994,-1816,-62743,100000,100000,-34068,65451,-100000,8293]","8"],"out":"8","g":1},{"in":["[54780,54780,54780,54780,94046,94046,547