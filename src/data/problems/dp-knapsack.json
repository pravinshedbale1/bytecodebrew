{"slug":"partition-equal-subset-sum","title":"Partition Equal Subset Sum","level":"Medium","summary":"Return whether the array can be split into two subsets with equal sums.","method":"canPartition","params":[["int[]","nums"]],"returns":"boolean","tests":[{"in":["[1,5,11,5]"],"out":"true"},{"in":["[1,2,3,5]"],"out":"false"},{"in":["[2,2]"],"out":"true"},{"in":["[1]"],"out":"false"},{"in":["[3,3,3,4,5]"],"out":"true"},{"in":[],"out":"\"#4:5b5c98ef514dbfa5\"","perf":{"label":"200 numbers","gen":"int[] a0 = BCB.ints(200, 1, 100);","floorMs":2000},"refMs":3}],"lesson":"dp-knapsack","anchor":"partition-equal-subset-sum"},
{"slug":"target-sum","title":"Target Sum","level":"Medium","summary":"Put + or − in front of every number. Return how many sign choices make the expression equal target.","method":"findTargetSumWays","params":[["int[]","nums"],["int","target"]],"returns":"int","tests":[{"in":["[1,1,1,1,1]","3"],"out":"5"},{"in":["[1]","1"],"out":"1"},{"in":["[1]","2"],"out":"0"},{"in":["[0,0,0]","0"],"out":"8"},{"in":["[2,3,7,1]","-1"],"out":"1"}],"lesson":"dp-knapsack","anchor":"target-sum--rewrite-the-problem-first"},
{"slug":"last-stone-weight-ii","title":"Last Stone Weight II","level":"Medium","summary":"Smashing stones x ≤ y leaves y − x (or nothing). Choose the pairs freely. Return the smallest possible weight of the last stone (0 if none remain).","method":"lastStoneWeightII","params":[["int[]","stones"]],"returns":"int","tests":[{"in":["[2,7,4,1,8,1]"],"out":"1"},{"in":["[31,26,33,21,40]"],"out":"5"},{"in":["[1]"],"out":"1"},{"in":["[1,1,4,2,2]"],"out":"0"}],"lesson":"dp-knapsack","anchor":"last-stone-weight-ii--closest-split"},
{"slug":"coin-change","title":"Coin Change","level":"Medium","summary":"With unlimited coins of each denomination, return the fewest coins that make up amount, or -1 if impossible.","method":"coinChange","params":[["int[]","coins"],["int","amount"]],"returns":"int","tests":[{"in":["[1,2,5]","11"],"out":"3"},{"in":["[2]","3"],"out":"-1"},{"in":["[1]","0"],"out":"0"},{"in":["[1,3,4]","6"],"out":"2"},{"in":["[186,419,83,408]","6249"],"out":"20"},{"in":[],"out":"\"#2:802ff07b4c31660\"","perf":{"label":"amount 10,000","gen":"int[] a0 = { 186, 419, 83, 408, 7, 13 }; int a1 = 10000;","floorMs":2000},"refMs":1}],"lesson":"dp-knapsack","anchor":"coin-change--fewest-coins"},
{"slug":"coin-change-ii","title":"Coin Change II","level":"Medium","summary":"With unlimited coins of each denomination, return how many combinations (order doesn't matter) make up amount.","method":"change","params":[["int","amount"],["int[]","coins"]],"returns":"int","tests":[{"in":["5","[1,2,5]"],"out":"4"},{"in":["3","[2]"],"out":"0"},{"in":["10","[10]"],"out":"1"},{"in":["0","[7]"],"out":"1"},{"in":["100","[1,5,10,25]"],"out":"242"}],"lesson":"dp-knapsack","anchor":"coin-change-ii--number-of-combinations"},
{"slug":"combination-sum-iv","title":"Combination Sum IV","level":"Medium","summary":"Count the ordered sequences of values from nums (reuse allowed) that sum to target. Different orders count separately.","method":"combinationSum4","params":[["int[]","nums"],["int","target"]],"returns":"int","tests":[{"in":["[1,2,3]","4"],"out":"7"},{"in":["[9]","3"],"out":"0"},{"in":["[1]","10"],"out":"1"},{"in":["[2,1,3]","35"],"out":"1132436852"}],"lesson":"dp-knapsack"},
{"slug":"perfect-squares","title":"Perfect Squares","level":"Medium","summary":"Return the fewest perfect squares (1, 4, 9, …) that sum to n.","method":"numSquares","params":[["int","n"]],"returns":"int","tests":[{"in":["12"],"out":"3"},{"in":["13"],"out":"2"},{"in":["1"],"out":"1"},{"in":["7"],"out":"4"},{"in":["9999"],"out":"4"}],"lesson":"dp-knapsack"},
{"slug":"ones-and-zeroes","title":"Ones and Zeroes","level":"Medium","summary":"Pick the largest subset of binary strings that uses at most m zeros and n ones in total. Return its size.","method":"findMaxForm","params":[["String[]","strs"],["int","m"],["int","n"]],"returns":"int","tests":[{"in":["[\"10\",\"0001\",\"111001\",\"1\",\"0\"]","5","3"],"out":"4"},{"in":["[\"10\",\"0\",\"1\"]","1","1"],"out":"2"},{"in":["[\"1\"]","0","0"],"out":"0"},{"in":["[\"00\",\"000\"]","1","10"],"out":"0"},{"in":[],"out":"\"#3:456fbc181822baa9\"","perf":{"label":"600 strings, m = n = 100","gen":"String[] a0 = BCB.words(600, 1, 10, \"01\"); int a1 = 100; int a2 = 100;","floorMs":2000},"refMs":11}],"lesson":"dp-knapsack"}
