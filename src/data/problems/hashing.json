{"slug":"two-sum","title":"Two Sum","level":"Easy","summary":"Return the indices of the two numbers that add up to target. Exactly one pair exists and you may not use the same element twice. Indices may be in either order.","method":"twoSum","params":[["int[]","nums"],["int","target"]],"returns":"int[]","check":"any-order","tests":[{"in":["[2,7,11,15]","9"],"out":"[0,1]"},{"in":["[3,2,4]","6"],"out":"[1,2]"},{"in":["[3,3]","6"],"out":"[0,1]"},{"in":["[-3,4,3,90]","0"],"out":"[0,2]"},{"in":["[0,4,3,0]","0"],"out":"[0,3]"},{"in":["[1,5,9,13,2]","15"],"out":"[3,4]"}],"lesson":"hashing","anchor":"two-sum"},
{"slug":"contains-duplicate","title":"Contains Duplicate","level":"Easy","summary":"Return true if any value appears at least twice in the array.","method":"containsDuplicate","params":[["int[]","nums"]],"returns":"boolean","tests":[{"in":["[1,2,3,1]"],"out":"true"},{"in":["[1,2,3,4]"],"out":"false"},{"in":["[1,1,1,3,3,4,3,2,4,2]"],"out":"true"},{"in":["[5]"],"out":"false"},{"in":["[-1,1]"],"out":"false"},{"in":[],"out":"\"#5:b5fae2c14238b978\"","perf":{"label":"n = 100,000, all distinct","gen":"int[] a0 = BCB.distinct(100000, -1000000000, 1000000000);"},"refMs":8}],"lesson":"hashing","anchor":"contains-duplicate"},
{"slug":"valid-anagram","title":"Valid Anagram","level":"Easy","summary":"Return true if t uses exactly the same letters as s, the same number of times (lowercase English letters).","method":"isAnagram","params":[["String","s"],["String","t"]],"returns":"boolean","tests":[{"in":["\"anagram\"","\"nagaram\""],"out":"true"},{"in":["\"rat\"","\"car\""],"out":"false"},{"in":["\"a\"","\"ab\""],"out":"false"},{"in":["\"aacc\"","\"ccac\""],"out":"false"},{"in":["\"listen\"","\"silent\""],"out":"true"},{"in":[],"out":"\"#4:5b5c98ef514dbfa5\"","perf":{"label":"strings of 50,000 letters","gen":"String a0 = BCB.str(50000, \"abcdefghijklmnopqrstuvwxyz\"); char[] c = a0.toCharArray(); for (int i = c.length - 1; i > 0; i--) { int j = BCB.R.nextInt(i + 1); char t = c[i]; c[i] = c[j]; c[j] = t; } String a1 = new String(c);"},"refMs":3}],"lesson":"hashing","anchor":"valid-anagram--counting-with-an-array"},
{"slug":"first-unique-character-in-a-string","title":"First Unique Character in a String","level":"Easy","summary":"Return the index of the first character that appears exactly once in s, or -1 if there is none.","method":"firstUniqChar","params":[["String","s"]],"returns":"int","tests":[{"in":["\"leetcode\""],"out":"0"},{"in":["\"loveleetcode\""],"out":"2"},{"in":["\"aabb\""],"out":"-1"},{"in":["\"z\""],"out":"0"},{"in":["\"abcabd\""],"out":"2"},{"in":[],"out":"\"#6:31755d1a8ea147a4\"","perf":{"label":"a 100,000-character string","gen":"String a0 = BCB.str(100000, \"abcdefghijklmnopqrstuvwxy\") + \"z\";"},"refMs":4}],"lesson":"hashing"},
{"slug":"group-anagrams","title":"Group Anagrams","level":"Medium","summary":"Group the words that are anagrams of each other. Groups, and the words inside them, may be in any order.","method":"groupAnagrams","params":[["String[]","strs"]],"returns":"List<List<String>>","check":"any-order-deep","tests":[{"in":["[\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]"],"out":"[[\"eat\",\"tea\",\"ate\"],[\"bat\"],[\"tan\",\"nat\"]]"},{"in":["[\"\"]"],"out":"[[\"\"]]"},{"in":["[\"a\"]"],"out":"[[\"a\"]]"},{"in":["[\"ab\",\"ba\",\"abc\",\"cab\",\"bca\",\"x\"]"],"out":"[[\"ab\",\"ba\"],[\"abc\",\"cab\",\"bca\"],[\"x\"]]"},{"in":["[\"\",\"b\",\"\"]"],"out":"[[\"\",\"\"],[\"b\"]]"},{"in":[],"out":"\"#187561:cdce213129cb6c9b\"","perf":{"label":"10,000 words","gen":"String[] a0 = BCB.words(10000, 1, 30, \"abc\");"},"refMs":14}],"lesson":"hashing","anchor":"group-anagrams--choosing-the-key"},
{"slug":"longest-consecutive-sequence","title":"Longest Consecutive Sequence","level":"Medium","summary":"Return the length of the longest run of consecutive integers (like 1, 2, 3, 4) that can be formed from the array's values, in O(n).","method":"longestConsecutive","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[100,4,200,1,3,2]"],"out":"4"},{"in":["[0,3,7,2,5,8,4,6,0,1]"],"out":"9"},{"in":["[]"],"out":"0"},{"in":["[1,2,0,1]"],"out":"3"},{"in":["[9,-1,8,-2,7,0]"],"out":"3"},{"in":[],"out":"\"#6:31755d1a8ea147a4\"","perf":{"label":"n = 100,000","gen":"int[] a0 = BCB.perm(100000, -50000);"},"refMs":27}],"lesson":"hashing","anchor":"longest-consecutive-sequence--the-start-of-a-run-trick"},
