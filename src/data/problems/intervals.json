{"slug":"merge-intervals","title":"Merge Intervals","level":"Medium","summary":"Merge all overlapping intervals (touching ones count as overlapping) and return the merged list sorted by start.","method":"merge","params":[["int[][]","intervals"]],"returns":"int[][]","check":"any-order","tests":[{"in":["[[1,3],[2,6],[8,10],[15,18]]"],"out":"[[1,6],[8,10],[15,18]]"},{"in":["[[1,4],[4,5]]"],"out":"[[1,5]]"},{"in":["[[4,7],[1,4]]"],"out":"[[1,7]]"},{"in":["[[1,4],[2,3]]"],"out":"[[1,4]]"},{"in":["[[5,5]]"],"out":"[[5,5]]"},{"in":["[[2,3],[4,5],[6,7],[8,9],[1,10]]"],"out":"[[1,10]]"},{"in":[],"out":"\"#94565:db7de22379b6f57b\"","perf":{"label":"10,000 intervals","gen":"int[][] a0 = BCB.intervals(10000, 0, 1000000, 100);"},"refMs":9}],"lesson":"intervals"},
{"slug":"insert-interval","title":"Insert Interval","level":"Medium","summary":"Insert newInterval into a sorted list of non-overlapping intervals, merging where needed, and return the result still sorted and non-overlapping.","method":"insert","params":[["int[][]","intervals"],["int[]","newInterval"]],"returns":"int[][]","tests":[{"in":["[[1,3],[6,9]]","[2,5]"],"out":"[[1,5],[6,9]]"},{"in":["[[1,2],[3,5],[6,7],[8,10],[12,16]]","[4,8]"],"out":"[[1,2],[3,10],[12,16]]"},{"in":["[]","[5,7]"],"out":"[[5,7]]"},{"in":["[[1,5]]","[6,8]"],"out":"[[1,5],[6,8]]"},{"in":["[[3,5]]","[1,2]"],"out":"[[1,2],[3,5]]"},{"in":["[[1,5]]","[0,9]"],"out":"[[0,9]]"}],"lesson":"intervals"},
{"slug":"non-overlapping-intervals","title":"Non-overlapping Intervals","level":"Medium","summary":"Return the fewest intervals to remove so the rest do not overlap. Intervals that only touch at an end do not overlap.","method":"eraseOverlapIntervals","params":[["int[][]","intervals"]],"returns":"int","tests":[{"in":["[[1,2],[2,3],[3,4],[1,3]]"],"out":"1"},{"in":["[[1,2],[1,2],[1,2]]"],"out":"2"},{"in":["[[1,2],[2,3]]"],"out":"0"},{"in":["[[1,100],[11,22],[1,11],[2,12]]"],"out":"2"},{"in":["[[0,2],[1,3],[2,4],[3,5],[4,6]]"],"out":"2"},{"in":[],"out":"\"#5:554dd2d6f2c9b800\"","perf":{"label":"100,000 intervals","gen":"int[][] a0 = BCB.intervals(100000, -50000, 50000, 1000);"},"refMs":30}],"lesson":"intervals","anchor":"non-overlapping-intervals--remove-the-fewest"},
{"slug":"minimum-number-of-arrows-to-burst-balloons","title":"Minimum Number of Arrows to Burst Balloons","level":"Medium","summary":"Each balloon spans [start, end] on the x-axis. A vertical arrow at x bursts every balloon with start ≤ x ≤ end. Return the fewest arrows to burst them all. Values can be as large as ±2^31.","method":"findMinArrowShots","params":[["int[][]","points"]],"returns":"int","tests":[{"in":["[[10,16],[2,8],[1,6],[7,12]]"],"out":"2"},{"in":["[[1,2],[3,4],[5,6],[7,8]]"],"out":"4"},{"in":["[[1,2],[2,3],[3,4],[4,5]]"],"out":"2"},{"in":["[[-2147483648,2147483647]]"],"out":"1"},{"in":["[[-2147483646,-2147483645],[2147483646,2147483647]]"],"out":"2"},{"in":[],"out":"\"#5:27763b7f43cc7ddf\"","perf":{"label":"100,000 balloons","gen":"int[][] a0 = BCB.intervals(100000, -1000000000, 1000000000, 1000000);"},"refMs":39}],"lesson":"intervals"},
{"slug":"interval-list-intersections","title":"Interval List Intersections","level":"Medium","summary":"Two lists of closed intervals are each sorted and pairwise disjoint. Return every intersection between them, in order.","method":"intervalIntersection","params":[["int[][]","firstList"],["int[][]","secondList"]],"returns":"int[][]","tests":[{"in":["[[0,2],[5,10],[13,23],[24,25]]","[[1,5],[8,12],[15,24],[25,26]]"],"out":"[[1,2],[5,5],[8,10],[15,23],[24,24],[25,25]]"},{"in":["[[1,3],[5,9]]","[]"],"out":"[]"},{"in":["[[1,7]]","[[3,10]]"],"out":"[[3,7]]"},{"in":["[[3,5],[9,20]]","[[4,5],[7,10],[11,12],[14,15],[16,20]]"],"out":"[[4,5],[9,10],[11,12],[14,15],[16,20]]"}],"lesson":"intervals"},
{"slug":"remove-covered-intervals","title":"Remove Covered Intervals","level":"Medium","summary":"Remove every interval [a, b) covered by another [c, d) (c ≤ a and b ≤ d). Return how many remain.","method":"removeCoveredIntervals","params":[["int[][]","intervals"]],"returns":"int","tests":[{"in":["[[1,4],[3,6],[2,8]]"],"out":"2"},{"in":["[[1,4],[2,3]]"],"out":"1"},{"in":["[[1,2]]"],"out":"1"},{"in":["[[1,2],[1,4],[3,4]]"],"out":"1"},{"in":["[[3,10],[4,10],[5,11]]"],"out":"2"}],"lesson":"intervals"},
{"slug":"minimum-interval-to-include-each-query","title":"Minimum Interval to Include Each Query","level":"Hard","summary":"For each query q, return the size (right − left + 1) of the smallest interval with left ≤ q ≤ right, or -1 if none contains it.","method":"minInterval","params":[["int[][]","intervals"],["int[]","queries"]],"returns":"int[]","tests":[{"in":["[[1,4],[2,4],[3,6],[4,4]]","[2,3,4,5]"],"out":"[3,3,1,4]"},{"in":["[[2,3],[2,5],[1,8],[20,25]]","[2,19,5,22]"],"out":"[2,-1,4,6]"},{"in":["[[5,5]]","[4,5,6]"],"out":"[-1,1,-1]"},{"in":["[[1,10],[3,3]]","[3,10,1]"],"out":"[1,10,10]"},{"in":[],"out":"\"#460281:936d7bc260f69bcf\"","perf":{"label":"100,000 intervals and queries","gen":"int[][] a0 = BCB.intervals(100000, 1, 10000000, 10000); int[] a1 = BCB.ints(100000, 1, 10000000);"},"refMs":123}],"lesson":"intervals"}
