{"slug":"running-sum-of-1d-array","title":"Running Sum of 1d Array","level":"Easy","summary":"Return the running sum: element i of the answer is nums[0] + … + nums[i].","method":"runningSum","params":[["int[]","nums"]],"returns":"int[]","tests":[{"in":["[1,2,3,4]"],"out":"[1,3,6,10]"},{"in":["[1,1,1,1,1]"],"out":"[1,2,3,4,5]"},{"in":["[3,1,2,10,1]"],"out":"[3,4,6,16,17]"},{"in":["[-5]"],"out":"[-5]"},{"in":["[0,-1,1]"],"out":"[0,-1,0]"}],"lesson":"prefix-sums"},
{"slug":"range-sum-query-immutable","title":"Range Sum Query - Immutable","level":"Easy","summary":"Build NumArray from an array, then answer many sumRange(left, right) queries (inclusive) quickly. The tests call the class like LeetCode: a list of operations and their arguments.","design":{"cls":"NumArray","ctor":[["int[]","nums"]],"methods":[["int","sumRange",[["int","left"],["int","right"]]]]},"tests":[{"in":["[\"NumArray\",\"sumRange\",\"sumRange\",\"sumRange\"]","[[[-2,0,3,-5,2,-1]],[0,2],[2,5],[0,5]]"],"out":"[null,1,-1,-3]"},{"in":["[\"NumArray\",\"sumRange\"]","[[[7]],[0,0]]"],"out":"[null,7]"},{"in":["[\"NumArray\",\"sumRange\",\"sumRange\",\"sumRange\"]","[[[1,2,3,4]],[1,1],[0,3],[3,3]]"],"out":"[null,2,10,4]"}],"lesson":"prefix-sums"},
{"slug":"find-pivot-index","title":"Find Pivot Index","level":"Easy","summary":"Return the leftmost index where the sum of the values strictly to its left equals the sum strictly to its right, or -1.","method":"pivotIndex","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[1,7,3,6,5,6]"],"out":"3"},{"in":["[1,2,3]"],"out":"-1"},{"in":["[2,1,-1]"],"out":"0"},{"in":["[0]"],"out":"0"},{"in":["[-1,-1,0,1,1,0]"],"out":"5"}],"lesson":"prefix-sums"},
{"slug":"subarray-sum-equals-k","title":"Subarray Sum Equals K","level":"Medium","summary":"Count the contiguous subarrays whose sum equals k. Values may be negative.","method":"subarraySum","params":[["int[]","nums"],["int","k"]],"returns":"int","tests":[{"in":["[1,1,1]","2"],"out":"2"},{"in":["[1,2,3]","3"],"out":"2"},{"in":["[1]","0"],"out":"0"},{"in":["[1,-1,0]","0"],"out":"3"},{"in":["[3,4,7,2,-3,1,4,2]","7"],"out":"4"},{"in":[],"out":"\"#4:fecd2b0b274a8acf\"","perf":{"label":"n = 20,000","gen":"int[] a0 = BCB.ints(20000, -1000, 1000); int a1 = 0;"},"refMs":13}],"lesson":"prefix-sums"},
{"slug":"subarray-sums-divisible-by-k","title":"Subarray Sums Divisible by K","level":"Medium","summary":"Count the non-empty contiguous subarrays whose sum is divisible by k. Values may be negative.","method":"subarraysDivByK","params":[["int[]","nums"],["int","k"]],"returns":"int","tests":[{"in":["[4,5,0,-2,-3,1]","5"],"out":"7"},{"in":["[5]","9"],"out":"0"},{"in":["[-1,2,9]","2"],"out":"2"},{"in":["[0,0,0]","3"],"out":"6"},{"in":["[-5,5,10]","5"],"out":"6"},{"in":[],"out":"\"#8:6173fa9997603a00\"","perf":{"label":"n = 30,000","gen":"int[] a0 = BCB.ints(30000, -10000, 10000); int a1 = 7;"},"refMs":7}],"lesson":"prefix-sums","anchor":"subarray-sums-divisible-by-k--remainders-instead-of-values"},
{"slug":"contiguous-array","title":"Contiguous Array","level":"Medium","summary":"In a binary array, return the length of the longest contiguous subarray with as many 0s as 1s.","method":"findMaxLength","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[0,1]"],"out":"2"},{"in":["[0,1,0]"],"out":"2"},{"in":["[0,1,1,1,1,1,0,0,0]"],"out":"6"},{"in":["[1,1,1]"],"out":"0"},{"in":["[0,0,1,0,0,0,1,1]"],"out":"6"},{"in":[],"out":"\"#5:82ce14065130729\"","perf":{"label":"n = 100,000","gen":"int[] a0 = BCB.ints(100000, 0, 1);"},"refMs":17}],"lesson":"prefix-sums","anchor":"contiguous-array--transform-then-zero-sum"},
{"slug":"product-of-array-except-self","title":"Product of Array Except Self","level":"Medium","summary":"Return an array where element i is the product of every other element, without using division, in O(n).","method":"productExceptSelf","params":[["int[]","nums"]],"returns":"int[]","tests":[{"in":["[1,2,3,4]"],"out":"[24,12,8,6]"},{"in":["[-1,1,0,-3,3]"],"out":"[0,0,9,0,0]"},{"in":["[2,3]"],"out":"[3,2]"},{"in":["[0,0,5]"],"out":"[0,0,0]"},{"in":["[-2,-3,4,1]"],"out":"[-12,-8,6,24]"},{"in":[],"out":"\"#249889:cf186f0e423aa8f1\"","perf":{"label":"n = 100,000","gen":"int[] a0 = new int[100000]; for (int i = 0; i < a0.length; i++) a0[i] = BCB.R.nextBoolean() ? 1 : -1;"},"refMs":4}],"lesson":"prefix-sums","anchor":"product-of-array-except-self--prefix-and-suffix"},
{"slug":"range-sum-query-2d-immutable","title":"Range Sum Query 2D - Immutable","level":"Medium","summary":"Build NumMatrix from a grid, then answer sumRegion(row1, col1, row2, col2) — the sum of a rectangle, corners inclusive — in O(1).","design":{"cls":"NumMatrix","ctor":[["int[][]","matrix"]],"methods":[["int","sumRegion",[["int","row1"],["int","col1"],["int","row2"],["int","col2"]]]]},"tests":[{"in":["[\"NumMatrix\",\"sumRegion\",\"sumRegion\",\"sumRegion\"]","[[[[3,0,1,4,2],[5,6,3,2,1],[1,2,0,1,5],[4,1,0,1,7],[1,0,3,0,5]]],[2,1,4,3],[1,1,2,2],[1,2,2,4]]"],"out":"[null,8,11,12]"},{"in":["[\"NumMatrix\",\"sumRegion\"]","[[[[-4]]],[0,0,0,0]]"],"out":"[null,-4]"},{"in":["[\"NumMatrix\",\"sumRegion\",\"sumRegion\"]","[[[[1,2],[3,4]]],[0,0,1,1],[1,0,1,1]]"],"out":"[null,10,7]"}],"lesson":"prefix-sums"},
{"slug":"corporate-flight-bookings","title":"Corporate Flight Bookings","level":"Medium","summary":"Flights are numbered 1..n. Each booking [first, last, seats] reserves seats on every flight from first to last. Return the total seats booked on each flight.","method":"corpFlightBookings","params":[["int[][]","bookings"],["int","n"]],"returns":"int[]","tests":[{"in":["[[1,2,10],[2,3,20],[2,5,25]]","5"],"out":"[10,55,45,25,25]"},{"in":["[[1,2,10],[2,2,15]]","2"],"out":"[10,25]"},{"in":["[[1,1,5]]","1"],"out":"[5]"},{"in":["[[1,3,1],[1,3,1]]","4"],"out":"[2,2,2,0]"},{"in":[],"out":"\"#177060:3f2687e6be11da2d\"","perf":{"label":"20,000 bookings over 20,000 flights","gen":"int[][] a0 = new int[20000][]; for (int i = 0; i < a0.length; i++) { int f = BCB.rnd(1, 20000), l = BCB.rnd(f, 20000); a0[i] = new int[] { f, l, BCB.rnd(1, 10000) }; } int a1 = 20000;"},"refMs":1}],"lesson":"prefix-sums"},
{"slug":"number-of-submatrices-that-sum-to-target","title":"Number of Submatrices That Sum to Target","level":"Hard","summary":"Count the non-empty rectangular submatrices whose values sum to target.","method":"numSubmatrixSumTarget","params":[["int[][]","matrix"],["int","target"]],"returns":"int","tests":[{"in":["[[0,1,0],[1,1,1],[0,1,0]]","0"],"out":"4"},{"in":["[[1,-1],[-1,1]]","0"],"out":"5"},{"in":["[[904]]","0"],"out":"0"},{"in":["[[1,1],[1,1]]","2"],"out":"4"},{"in":["[[0,0,0]]","0"],"out":"6"},{"in":[],"out":"\"#6:234952ced019f470\"","perf":{"label":"a 100×100 matrix","gen":"int[][] a0 = BCB.grid(100, 100, -1, 1); int a1 = 0;"},"refMs":25}],"lesson":"prefix-sums"}
]
