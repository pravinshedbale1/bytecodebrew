{"slug":"regular-expression-matching","title":"Regular Expression Matching","level":"Hard","summary":"Match the whole string s against pattern p, where \".\" matches any character and \"*\" matches zero or more of the preceding element.","method":"isMatch","params":[["String","s"],["String","p"]],"returns":"boolean","tests":[{"in":["\"aa\"","\"a\""],"out":"false"},{"in":["\"aa\"","\"a*\""],"out":"true"},{"in":["\"ab\"","\".*\""],"out":"true"},{"in":["\"aab\"","\"c*a*b\""],"out":"true"},{"in":["\"mississippi\"","\"mis*is*p*.\""],"out":"false"},{"in":["\"\"","\"a*b*\""],"out":"true"},{"in":[],"out":"\"#5:b5fae2c14238b978\"","perf":{"label":"a pattern that defeats plain backtracking","gen":"String a0 = \"a\".repeat(20) + \"b\"; String a1 = \"a*\".repeat(10) + \"c\";","floorMs":2000},"refMs":1}],"lesson":"dp-strings"}
