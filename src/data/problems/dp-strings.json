{"slug":"delete-operation-for-two-strings","title":"Delete Operation for Two Strings","level":"Medium","summary":"Each step deletes one character from either string. Return the fewest steps to make the two strings equal.","method":"minDistance","params":[["String","word1"],["String","word2"]],"returns":"int","tests":[{"in":["\"sea\"","\"eat\""],"out":"2"},{"in":["\"leetcode\"","\"etco\""],"out":"4"},{"in":["\"a\"","\"a\""],"out":"0"},{"in":["\"abc\"","\"xyz\""],"out":"6"},{"in":["\"intention\"","\"execution\""],"out":"8"},{"in":[],"out":"\"#3:6056ae1827a1f5d0\"","perf":{"label":"two 500-character strings","gen":"String a0 = BCB.str(500, \"abc\"); String a1 = BCB.str(500, \"abc\");","floorMs":2000},"refMs":19}],"lesson":"dp-strings"},
{"slug":"longest-palindromic-substring","title":"Longest Palindromic Substring","level":"Medium","summary":"Return a longest substring of s that is a palindrome. Any palindrome of the maximum length is accepted.","method":"longestPalindrome","params":[["String","s"]],"returns":"String","check":"custom:palindrome","tests":[{"in":["\"babad\""],"out":"\"bab\""},{"in":["\"cbbd\""],"out":"\"bb\""},{"in":["\"a\""],"out":"\"a\""},{"in":["\"forgeeksskeegfor\""],"out":"\"geeksskeeg\""},{"in":["\"abcda\""],"out":"\"a\""},{"in":[],"out":"\"#2:8030507b4c32092\"","perf":{"label":"a 1,000-character string (length compared)","gen":"String a0 = BCB.str(1000, \"ab\");","call":"Object r = s.longestPalindrome(a0).length();","floorMs":2000},"refMs":1}],"lesson":"dp-strings","anchor":"longest-palindromic-substring--expand-around-centres"},
{"slug":"longest-palindromic-subsequence","title":"Longest Palindromic Subsequence","level":"Medium","summary":"Return the length of the longest subsequence of s that is a palindrome.","method":"longestPalindromeSubseq","params":[["String","s"]],"returns":"int","tests":[{"in":["\"bbbab\""],"out":"4"},{"in":["\"cbbd\""],"out":"2"},{"in":["\"a\""],"out":"1"},{"in":["\"agbdba\""],"out":"5"},{"in":["\"abcdef\""],"out":"1"},{"in":[],"out":"\"#3:34ef6a180f05a611\"","perf":{"label":"a 1,000-character string","gen":"String a0 = BCB.str(1000, \"abc\");","floorMs":2000},"refMs":10}],"lesson":"dp-strings","anchor":"longest-palindromic-subsequence"},
{"slug":"palindromic-substrings","title":"Palindromic Substrings","level":"Medium","summary":"Count the substrings of s that are palindromes (substrings at different positions count separately).","method":"countSubstrings","params":[["String","s"]],"returns":"int","tests":[{"in":["\"abc\""],"out":"3"},{"in":["\"aaa\""],"out":"6"},{"in":["\"a\""],"out":"1"},{"in":["\"abba\""],"out":"6"},{"in":["\"racecar\""],"out":"10"},{"in":[],"out":"\"#4:630321024247f5a0\"","perf":{"label":"a 1,000-character string","gen":"String a0 = BCB.str(1000, \"ab\");","floorMs":2000},"refMs":1}],"lesson":"dp-strings"},
{"slug":"interleaving-string","title":"Interleaving String","level":"Medium","summary":"Return whether s3 can be formed by interleaving s1 and s2, keeping each string's characters in their original order.","method":"isInterleave","params":[["String","s1"],["String","s2"],["String","s3"]],"returns":"boolean","tests":[{"in":["\"aabcc\"","\"dbbca\"","\"aadbbcbcac\""],"out":"true"},{"in":["\"aabcc\"","\"dbbca\"","\"aadbbbaccc\""],"out":"false"},{"in":["\"\"","\"\"","\"\""],"out":"true"},{"in":["\"a\"","\"\"","\"a\""],"out":"true"},{"in":["\"ab\"","\"cd\"","\"acdb\""],"out":"true"},{"in":[],"out":"\"#5:b5fae2c14238b978\"","perf":{"label":"100 + 100 characters","gen":"String a0 = \"a\".repeat(100); String a1 = \"a\".repeat(99) + \"b\"; String a2 = \"a\".repeat(200);","floorMs":2000},"refMs":1}],"lesson":"dp-strings","anchor":"interleaving-string"},
{"slug":"edit-distance","title":"Edit Distance","level":"Medium","summary":"Return the fewest insertions, deletions and replacements of single characters that turn word1 into word2.","method":"minDistance","params":[["String","word1"],["String","word2"]],"returns":"int","tests":[{"in":["\"horse\"","\"ros\""],"out":"3"},{"in":["\"intention\"","\"execution\""],"out":"5"},{"in":["\"\"","\"abc\""],"out":"3"},{"in":["\"same\"","\"same\""],"out":"0"},{"in":["\"kitten\"","\"sitting\""],"out":"3"},{"in":[],"out":"\"#3:6037bb1827875b58\"","perf":{"label":"two 500-character strings","gen":"String a0 = BCB.str(500, \"abcd\"); String a1 = BCB.str(500, \"abcd\");","floorMs":2000},"refMs":11}],"lesson":"dp-strings","anchor":"edit-distance--three-operations-three-neighbours"},
