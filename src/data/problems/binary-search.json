{"slug":"binary-search","title":"Binary Search","level":"Easy","summary":"Return the index of target in a sorted array of distinct values, or -1, in O(log n).","method":"search","params":[["int[]","nums"],["int","target"]],"returns":"int","tests":[{"in":["[-1,0,3,5,9,12]","9"],"out":"4"},{"in":["[-1,0,3,5,9,12]","2"],"out":"-1"},{"in":["[5]","5"],"out":"0"},{"in":["[5]","-5"],"out":"-1"},{"in":["[1,3,5,7,9,11,13]","1"],"out":"0"},{"in":["[1,3,5,7,9,11,13]","13"],"out":"6"}],"lesson":"binary-search"},
{"slug":"search-insert-position","title":"Search Insert Position","level":"Easy","summary":"In a sorted array of distinct values, return the index of target, or the index where it would be inserted to keep the order.","method":"searchInsert","params":[["int[]","nums"],["int","target"]],"returns":"int","tests":[{"in":["[1,3,5,6]","5"],"out":"2"},{"in":["[1,3,5,6]","2"],"out":"1"},{"in":["[1,3,5,6]","7"],"out":"4"},{"in":["[1,3,5,6]","0"],"out":"0"},{"in":["[1]","1"],"out":"0"}],"lesson":"binary-search"},
{"slug":"first-bad-version","title":"First Bad Version","level":"Easy","summary":"Versions 1..n are good up to some version, then every later one is bad. Using the provided isBadVersion(v), find the first bad version with as few calls as possible. (The tests also tell the judge which version is the first bad one.)","method":"firstBadVersion","params":[["int","n"],["int","bad"]],"starterParams":[["int","n"]],"returns":"int","uses":["VersionControl"],"extends":"VersionControl","call":"VersionControl.BAD = BCB.I($1); Object r = s.firstBadVersion(BCB.I($0));","tests":[{"in":["5","4"],"out":"4"},{"in":["1","1"],"out":"1"},{"in":["10","1"],"out":"1"},{"in":["10","10"],"out":"10"},{"in":["2126753390","1702766719"],"out":"1702766719"}],"lesson":"binary-search"},
{"slug":"sqrtx","title":"Sqrt(x)","level":"Easy","summary":"Return the square root of a non-negative integer x, rounded down, without using a built-in power or sqrt function.","method":"mySqrt","params":[["int","x"]],"returns":"int","tests":[{"in":["4"],"out":"2"},{"in":["8"],"out":"2"},{"in":["0"],"out":"0"},{"in":["1"],"out":"1"},{"in":["2147395599"],"out":"46339"},{"in":["2147483647"],"out":"46340"}],"lesson":"binary-search"},
{"slug":"find-first-and-last-position-of-element-in-sorted-array","title":"Find First and Last Position of Element in Sorted Array","level":"Medium","summary":"In a sorted array (duplicates allowed), return [first, last] index of target, or [-1, -1], in O(log n).","method":"searchRange","params":[["int[]","nums"],["int","target"]],"returns":"int[]","tests":[{"in":["[5,7,7,8,8,10]","8"],"out":"[3,4]"},{"in":["[5,7,7,8,8,10]","6"],"out":"[-1,-1]"},{"in":["[]","0"],"out":"[-1,-1]"},{"in":["[1]","1"],"out":"[0,0]"},{"in":["[2,2,2,2]","2"],"out":"[0,3]"},{"in":["[1,2,3]","3"],"out":"[2,2]"}],"lesson":"binary-search"},
{"slug":"search-a-2d-matrix","title":"Search a 2D Matrix","level":"Medium","summary":"Each row is sorted and each row starts after the previous row ends. Return whether target is in the matrix, in O(log(m·n)).","method":"searchMatrix","params":[["int[][]","matrix"],["int","target"]],"returns":"boolean","tests":[{"in":["[[1,3,5,7],[10,11,16,20],[23,30,34,60]]","3"],"out":"true"},{"in":["[[1,3,5,7],[10,11,16,20],[23,30,34,60]]","13"],"out":"false"},{"in":["[[1]]","1"],"out":"true"},{"in":["[[1,3]]","3"],"out":"true"},{"in":["[[1],[3]]","2"],"out":"false"}],"lesson":"binary-search","anchor":"search-a-2d-matrix"},
{"slug":"find-minimum-in-rotated-sorted-array","title":"Find Minimum in Rotated Sorted Array","level":"Medium","summary":"A sorted array of distinct values was rotated some number of times. Return its minimum in O(log n).","method":"findMin","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[3,4,5,1,2]"],"out":"1"},{"in":["[4,5,6,7,0,1,2]"],"out":"0"},{"in":["[11,13,15,17]"],"out":"11"},{"in":["[2,1]"],"out":"1"},{"in":["[5]"],"out":"5"}],"lesson":"binary-search"},
{"slug":"search-in-rotated-sorted-array","title":"Search in Rotated Sorted Array","level":"Medium","summary":"A sorted array of distinct values was rotated at an unknown pivot. Return the index of target or -1, in O(log n).","method":"search","params":[["int[]","nums"],["int","target"]],"returns":"int","tests":[{"in":["[4,5,6,7,0,1,2]","0"],"out":"4"},{"in":["[4,5,6,7,0,1,2]","3"],"out":"-1"},{"in":["[1]","0"],"out":"-1"},{"in":["[3,1]","1"],"out":"1"},{"in":["[5,1,3]","5"],"out":"0"},{"in":["[6,7,1,2,3,4,5]","7"],"out":"1"}],"lesson":"binary-search"},
{"slug":"find-peak-element","title":"Find Peak Element","level":"Medium","summary":"Return the index of any element strictly greater than its neighbours (treat the outside as −∞; neighbours are never equal), in O(log n). Any peak is accepted.","method":"findPeakElement","params":[["int[]","nums"]],"returns":"int","check":"custom:peak","tests":[{"in":["[1,2,3,1]"],"out":"2"},{"in":["[1,2,1,3,5,6,4]"],"out":"5"},{"in":["[1]"],"out":"0"},{"in":["[2,1]"],"out":"0"},{"in":["[1,2,3,4,5]"],"out":"4"}],"lesson":"binary-search"},
{"slug":"median-of-two-sorted-arrays","title":"Median of Two Sorted Arrays","level":"Hard","summary":"Return the median of two sorted arrays taken together, in O(log(m + n)).","method":"findMedianSortedArrays","params":[["int[]","nums1"],["int[]","nums2"]],"returns":"double","tests":[{"in":["[1,3]","[2]"],"out":"2.0"},{"in":["[1,2]","[3,4]"],"out":"2.5"},{"in":["[]","[1]"],"out":"1.0"},{"in":["[0,0]","[0,0]"],"out":"0.0"},{"in":["[1,5,9]","[2,3,4,10,11]"],"out":"4.5"}],"lesson":"binary-search"}
