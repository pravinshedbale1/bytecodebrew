{"slug":"house-robber","title":"House Robber","level":"Medium","summary":"You can't rob two adjacent houses. Return the most money you can rob.","method":"rob","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[1,2,3,1]"],"out":"4"},{"in":["[2,7,9,3,1]"],"out":"12"},{"in":["[5]"],"out":"5"},{"in":["[2,1,1,2]"],"out":"4"},{"in":["[0,0,0]"],"out":"0"},{"in":[],"out":"\"#5:fbe5f77f2b0d290c\"","perf":{"label":"100 houses","gen":"int[] a0 = BCB.ints(100, 0, 400);","floorMs":2000},"refMs":1}],"lesson":"dp-linear","anchor":"shape-1-take-or-skip--house-robber"},
{"slug":"house-robber-ii","title":"House Robber II","level":"Medium","summary":"The houses form a circle, so the first and last are adjacent. You can't rob two adjacent houses. Return the most money you can rob.","method":"rob","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[2,3,2]"],"out":"3"},{"in":["[1,2,3,1]"],"out":"4"},{"in":["[1,2,3]"],"out":"3"},{"in":["[7]"],"out":"7"},{"in":["[200,3,140,20,10]"],"out":"340"},{"in":[],"out":"\"#5:bab333d6be189bd1\"","perf":{"label":"100 houses","gen":"int[] a0 = BCB.ints(100, 0, 1000);","floorMs":2000},"refMs":1}],"lesson":"dp-linear"},
{"slug":"maximum-subarray","title":"Maximum Subarray","level":"Medium","summary":"Return the largest sum of any non-empty contiguous subarray.","method":"maxSubArray","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[-2,1,-3,4,-1,2,1,-5,4]"],"out":"6"},{"in":["[1]"],"out":"1"},{"in":["[5,4,-1,7,8]"],"out":"23"},{"in":["[-3,-1,-2]"],"out":"-1"},{"in":["[-1,0,-2]"],"out":"0"},{"in":[],"out":"\"#7:45bb8fe2f71c9e2a\"","perf":{"label":"n = 100,000","gen":"int[] a0 = BCB.ints(100000, -10000, 10000);","floorMs":2000},"refMs":5}],"lesson":"dp-linear"},
{"slug":"maximum-product-subarray","title":"Maximum Product Subarray","level":"Medium","summary":"Return the largest product of any non-empty contiguous subarray.","method":"maxProduct","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[2,3,-2,4]"],"out":"6"},{"in":["[-2,0,-1]"],"out":"0"},{"in":["[-2]"],"out":"-2"},{"in":["[-2,3,-4]"],"out":"24"},{"in":["[0,2,-3,-2,0,5,-1]"],"out":"12"}],"lesson":"dp-linear","anchor":"variation-maximum-product-subarray"},
{"slug":"decode-ways","title":"Decode Ways","level":"Medium","summary":"Letters map to \"1\"..\"26\". Return how many ways the digit string can be decoded (\"06\" is not a valid code).","method":"numDecodings","params":[["String","s"]],"returns":"int","tests":[{"in":["\"12\""],"out":"2"},{"in":["\"226\""],"out":"3"},{"in":["\"06\""],"out":"0"},{"in":["\"10\""],"out":"1"},{"in":["\"11106\""],"out":"2"},{"in":["\"2101\""],"out":"1"},{"in":[],"out":"\"#10:b1a257ab8d7387ba\"","perf":{"label":"a 44-digit string","gen":"String a0 = \"1\".repeat(44);","floorMs":2000},"refMs":1}],"lesson":"dp-linear","anchor":"decode-ways"},
{"slug":"word-break","title":"Word Break","level":"Medium","summary":"Return whether s can be split into a sequence of dictionary words (words may be reused).","method":"wordBreak","params":[["String","s"],["List<String>","wordDict"]],"returns":"boolean","tests":[{"in":["\"leetcode\"","[\"leet\",\"code\"]"],"out":"true"},{"in":["\"applepenapple\"","[\"apple\",\"pen\"]"],"out":"true"},{"in":["\"catsandog\"","[\"cats\",\"dog\",\"sand\",\"and\",\"cat\"]"],"out":"false"},{"in":["\"a\"","[\"b\"]"],"out":"false"},{"in":["\"aaaaaaa\"","[\"aaaa\",\"aaa\"]"],"out":"true"},{"in":[],"out":"\"#5:b5fae2c14238b978\"","perf":{"label":"a 151-character string","gen":"String a0 = \"a\".repeat(150) + \"b\"; List<String> a1 = new ArrayList<>(); for (int i = 1; i <= 10; i++) a1.add(\"a\".repeat(i));","floorMs":2000},"refMs":6}],"lesson":"dp-linear","anchor":"word-break"},
{"slug":"longest-increasing-subsequence","title":"Longest Increasing Subsequence","level":"Medium","summary":"Return the length of the longest strictly increasing subsequence — O(n log n) if you can.","method":"lengthOfLIS","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[10,9,2,5,3,7,101,18]"],"out":"4"},{"in":["[0,1,0,3,2,3]"],"out":"4"},{"in":["[7,7,7,7,7,7,7]"],"out":"1"},{"in":["[1]"],"out":"1"},{"in":["[4,10,4,3,8,9]"],"out":"3"},{"in":[],"out":"\"#2:8140007b4d18b46\"","perf":{"label":"n = 2,500","gen":"int[] a0 = BCB.ints(2500, -10000, 10000);","floorMs":2000},"refMs":1}],"lesson":"dp-linear"},
{"slug":"number-of-longest-increasing-subsequence","title":"Number of Longest Increasing Subsequence","level":"Medium","summary":"Return how many longest strictly increasing subsequences there are.","method":"findNumberOfLIS","params":[["int[]","nums"]],"returns":"int","tests":[{"in":["[1,3,5,4,7]"],"out":"2"},{"in":["[2,2,2,2,2]"],"out":"5"},{"in":["[1]"],"out":"1"},{"in":["[1,2,4,3,5,4,7,2]"],"out":"3"}],"lesson":"dp-linear"},
{"slug":"best-time-to-buy-and-sell-stock-with-cooldown","title":"Best Time to Buy and Sell Stock with Cooldown","level":"Medium","summary":"Trade as often as you like (one share at a time), but after selling you must skip the next day. Return the maximum profit.","method":"maxProfit","params":[["int[]","prices"]],"returns":"int","tests":[{"in":["[1,2,3,0,2]"],"out":"3"},{"in":["[1]"],"out":"0"},{"in":["[6,1,3,2,4,7]"],"out":"6"},{"in":["[1,2,4]"],"out":"3"},{"in":[],"out":"\"#6:76c3c4ebb91112af\"","perf":{"label":"5,000 days","gen":"int[] a0 = BCB.ints(5000, 0, 1000);","floorMs":2000},"refMs":1}],"lesson":"dp-linear"},
{"slug":"russian-doll-envelopes","title":"Russian Doll Envelopes","level":"Hard","summary":"An envelope fits into another only if both its width and height are strictly smaller. Return the most envelopes you can nest.","method":"maxEnvelopes","params":[["int[][]","envelopes"]],"returns":"int","tests":[{"in":["[[5,4],[6,4],[6,7],[2,3]]"],"out":"3"},{"in":["[[1,1],[1,1],[1,1]]"],"out":"1"},{"in":["[[4,5],[4,6],[6,7],[2,3],[1,1]]"],"out":"4"},{"in":["[[1,3],[3,5],[6,7],[6,8],[8,4],[9,5]]"],"out":"3"},{"in":[],"out":"\"#3:3e020f181446d523\"","perf":{"label":"100,000 envelopes","gen":"int[][] a0 = new int[100000][]; for (int i = 0; i < a0.length; i++) a0[i] = new int[] { BCB.rnd(1, 100000), BCB.rnd(1, 100000) };","floorMs":2000},"refMs":35}],"lesson":"dp-linear"}
]
