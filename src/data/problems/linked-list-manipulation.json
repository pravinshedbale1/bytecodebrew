[
{"slug":"reverse-linked-list","title":"Reverse Linked List","level":"Easy","summary":"Reverse a singly linked list and return the new head.","method":"reverseList","params":[["ListNode","head"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4,5]"],"out":"[5,4,3,2,1]"},{"in":["[1,2]"],"out":"[2,1]"},{"in":["[]"],"out":"[]"},{"in":["[7]"],"out":"[7]"}],"lesson":"linked-list-manipulation"},
{"slug":"merge-two-sorted-lists","title":"Merge Two Sorted Lists","level":"Easy","summary":"Merge two sorted linked lists into one sorted list by splicing their nodes together; return its head.","method":"mergeTwoLists","params":[["ListNode","list1"],["ListNode","list2"]],"returns":"ListNode","tests":[{"in":["[1,2,4]","[1,3,4]"],"out":"[1,1,2,3,4,4]"},{"in":["[]","[]"],"out":"[]"},{"in":["[]","[0]"],"out":"[0]"},{"in":["[5]","[1,2,4]"],"out":"[1,2,4,5]"},{"in":["[-3,7,9]","[-3,-2,10]"],"out":"[-3,-3,-2,7,9,10]"}],"lesson":"linked-list-manipulation","anchor":"merge-two-sorted-lists"},
{"slug":"remove-linked-list-elements","title":"Remove Linked List Elements","level":"Easy","summary":"Remove every node whose value equals val and return the new head.","method":"removeElements","params":[["ListNode","head"],["int","val"]],"returns":"ListNode","tests":[{"in":["[1,2,6,3,4,5,6]","6"],"out":"[1,2,3,4,5]"},{"in":["[]","1"],"out":"[]"},{"in":["[7,7,7,7]","7"],"out":"[]"},{"in":["[1,2,2,1]","2"],"out":"[1,1]"},{"in":["[1]","2"],"out":"[1]"}],"lesson":"linked-list-manipulation"},
{"slug":"add-two-numbers","title":"Add Two Numbers","level":"Medium","summary":"Two non-negative numbers are stored as linked lists of digits in reverse order (ones digit first). Return their sum in the same form.","method":"addTwoNumbers","params":[["ListNode","l1"],["ListNode","l2"]],"returns":"ListNode","tests":[{"in":["[2,4,3]","[5,6,4]"],"out":"[7,0,8]"},{"in":["[0]","[0]"],"out":"[0]"},{"in":["[9,9,9,9,9,9,9]","[9,9,9,9]"],"out":"[8,9,9,9,0,0,0,1]"},{"in":["[5]","[5]"],"out":"[0,1]"},{"in":["[1,8]","[0]"],"out":"[1,8]"}],"lesson":"linked-list-manipulation","anchor":"add-two-numbers-digits-stored-in-reverse"},
{"slug":"reverse-linked-list-ii","title":"Reverse Linked List II","level":"Medium","summary":"Reverse the nodes from position left to position right (1-indexed, inclusive) in one pass and return the head.","method":"reverseBetween","params":[["ListNode","head"],["int","left"],["int","right"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4,5]","2","4"],"out":"[1,4,3,2,5]"},{"in":["[5]","1","1"],"out":"[5]"},{"in":["[3,5]","1","2"],"out":"[5,3]"},{"in":["[1,2,3,4,5]","1","5"],"out":"[5,4,3,2,1]"},{"in":["[1,2,3]","3","3"],"out":"[1,2,3]"}],"lesson":"linked-list-manipulation"},
{"slug":"swap-nodes-in-pairs","title":"Swap Nodes in Pairs","level":"Medium","summary":"Swap every two adjacent nodes (by relinking nodes, not by changing values) and return the head.","method":"swapPairs","params":[["ListNode","head"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4]"],"out":"[2,1,4,3]"},{"in":["[]"],"out":"[]"},{"in":["[1]"],"out":"[1]"},{"in":["[1,2,3]"],"out":"[2,1,3]"},{"in":["[6,5,4,3,2,1]"],"out":"[5,6,3,4,1,2]"}],"lesson":"linked-list-manipulation"},
{"slug":"partition-list","title":"Partition List","level":"Medium","summary":"Move every node with value less than x before the nodes with value ≥ x, keeping the original relative order within each part.","method":"partition","params":[["ListNode","head"],["int","x"]],"returns":"ListNode","tests":[{"in":["[1,4,3,2,5,2]","3"],"out":"[1,2,2,4,3,5]"},{"in":["[2,1]","2"],"out":"[1,2]"},{"in":["[]","0"],"out":"[]"},{"in":["[5,4,3]","1"],"out":"[5,4,3]"},{"in":["[1,2,3]","4"],"out":"[1,2,3]"}],"lesson":"linked-list-manipulation"},
{"slug":"rotate-list","title":"Rotate List","level":"Medium","summary":"Rotate the list to the right by k places (k may exceed the length) and return the new head.","method":"rotateRight","params":[["ListNode","head"],["int","k"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4,5]","2"],"out":"[4,5,1,2,3]"},{"in":["[0,1,2]","4"],"out":"[2,0,1]"},{"in":["[]","3"],"out":"[]"},{"in":["[1]","99"],"out":"[1]"},{"in":["[1,2]","2"],"out":"[1,2]"}],"lesson":"linked-list-manipulation"},
{"slug":"reverse-nodes-in-k-group","title":"Reverse Nodes in k-Group","level":"Hard","summary":"Reverse the nodes k at a time; a final group shorter than k stays as it is. Use O(1) extra memory.","method":"reverseKGroup","params":[["ListNode","head"],["int","k"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4,5]","2"],"out":"[2,1,4,3,5]"},{"in":["[1,2,3,4,5]","3"],"out":"[3,2,1,4,5]"},{"in":["[1,2,3,4]","1"],"out":"[1,2,3,4]"},{"in":["[1,2,3,4]","4"],"out":"[4,3,2,1]"},{"in":["[1,2,3,4,5,6,7]","3"],"out":"[3,2,1,6,5,4,7]"}],"lesson":"linked-list-manipulation"}
]
