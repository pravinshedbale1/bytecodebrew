{"slug":"reverse-linked-list","title":"Reverse Linked List","level":"Easy","summary":"Reverse a singly linked list and return the new head.","method":"reverseList","params":[["ListNode","head"]],"returns":"ListNode","tests":[{"in":["[1,2,3,4,5]"],"out":"[5,4,3,2,1]"},{"in":["[1,2]"],"out":"[2,1]"},{"in":["[]"],"out":"[]"},{"in":["[7]"],"out":"[7]"},{"in":["[-427,3760]"],"out":"[3760,-427]","g":1},{"in":["[-5000,2770]"],"out":"[2770,-5000]","g":1},{"in":["[-914]"],"out":"[-914]","g":1},{"in":["[-3093,-3092]"],"out":"[-3092,-3093]","g":1},{"in":["[-4562,-4560,-4562,-4558,-4557,-4562,-4561,-4558]"],"out":"[-4558,-4561,-4562,-4557,-4558,-4562,-4560,-4562]","g":1},{"in":["[2676,2676,2676,2676,5000,5000,5000]"],"out":"[5000,5000,5000,2676,2676,2676,2676]","g":1},{"in":["[-2428,-2428,4868,4868,4868,4868,-2428,4868,4868]"],"out":"[4868,4868,-2428,4868,4868,4868,4868,-2428,-2428]","g":1},{"in":["[-2489,4416,-2489,4416,-2489,4416]"],"out":"[4416,-2489,4416,-2489,4416,-2489]","g":1},{"in":["[-5000,2767]"],"out":"[2767,-5000]","g":1},{"in":["[-3017]"],"out":"[-3017]","g":1},{"in":["[2222]"],"out":"[2222]","g":1},{"in":["[4570,4570,4570,3419,3419]"],"out":"[3419,3419,4570,4570,4570]","g":1},{"in":["[-1981]"],"out":"[-1981]","g":1},{"in":["[5000]"],"out":"[5000]","g":1},{"in":["[-3909,-3910]"],"out":"[-3910,-3909]","g":1},{"in":["[-722,-2469,5000]"],"out":"[5000,-2469,-722]","g":1},{"in":["[1733,-1,-499,-2166,-3899,-4591]"],"out":"[-4591,-3899,-2166,-499,-1,1733]","g":1},{"in":["[5000,-4438,3518,864,-103,-1035,0,-5000]"],"out":"[-5000,0,-1035,-103,864,3518,-4438,5000]","g":1},{"in":["[1586,1587,1585,1584,1589]"],"out":"[1589,1584,1585,1587,1586]","g":1},{"in":["[5000,-2407,4931,1787,3460,1393,1068,-4100,-1442,-1321]"],"out":"[-1321,-1442,-4100,1068,1393,3460,1787,4931,-2407,5000]","g":1},{"in":["[0,0]"],"out":"[0,0]","g":1},{"in":["[-5000,-3074,-2138,-420,3229,3389,5000]"],"out":"[5000,3389,3229,-420,-2138,-3074,-5000]","g":1},{"in":["[-3327,-3325]"],"out":"[-3325,-3327]","g":1},