{"slug":"repeated-dna-sequences","title":"Repeated DNA Sequences","level":"Medium","summary":"Return every 10-letter substring that occurs more than once in the DNA string, in any order.","method":"findRepeatedDnaSequences","params":[["String","s"]],"returns":"List<String>","check":"any-order","tests":[{"in":["\"AAAAACCCCCAAAAACCCCCCAAAAAGGGTTT\""],"out":"[\"AAAAACCCCC\",\"CCCCCAAAAA\"]"},{"in":["\"AAAAAAAAAAAAA\""],"out":"[\"AAAAAAAAAA\"]"},{"in":["\"ACGT\""],"out":"[]"},{"in":["\"AAAAAAAAAAA\""],"out":"[\"AAAAAAAAAA\"]"},{"in":[],"out":"\"#58124:236b5af26b2d6f90\"","perf":{"label":"a 100,000-letter DNA string","gen":"String a0 = BCB.str(100000, \"ACGT\");"},"refMs":28}],"lesson":"string-matching"},
{"slug":"longest-happy-prefix","title":"Longest Happy Prefix","level":"Hard","summary":"Return the longest non-empty proper prefix of s that is also a suffix (overlaps allowed), or \"\".","method":"longestPrefix","params":[["String","s"]],"returns":"String","tests":[{"in":["\"level\""],"out":"\"l\""},{"in":["\"ababab\""],"out":"\"abab\""},{"in":["\"a\""],"out":"\"\""},{"in":["\"aaaa\""],"out":"\"aaa\""},{"in":["\"abcd\""],"out":"\"\""},{"in":[],"out":"\"#2:7cc7607b4949e25\"","perf":{"label":"a 100,000-character string","gen":"String a0 = \"a\".repeat(99999) + \"b\";"},"refMs":7}],"lesson":"string-matching"},
{"slug":"shortest-palindrome","title":"Shortest Palindrome","level":"Hard","summary":"Add the fewest characters in front of s to make it a palindrome, and return that palindrome.","method":"shortestPalindrome","params":[["String","s"]],"returns":"String","tests":[{"in":["\"aacecaaa\""],"out":"\"aaacecaaa\""},{"in":["\"abcd\""],"out":"\"dcbabcd\""},{"in":["\"\""],"out":"\"\""},{"in":["\"a\""],"out":"\"a\""},{"in":["\"abab\""],"out":"\"babab\""},{"in":[],"out":"\"#75002:36236506721ab2ef\"","perf":{"label":"a 50,000-character string","gen":"String a0 = \"a\".repeat(25000) + \"b\" + \"a\".repeat(24999);"},"refMs":9}],"lesson":"string-matching"},
{"slug":"longest-duplicate-substring","title":"Longest Duplicate Substring","level":"Hard","summary":"Return any longest substring that occurs at least twice in s (occurrences may overlap), or \"\" if none.","method":"longestDupSubstring","params":[["String","s"]],"returns":"String","check":"custom:duplicateSubstring","tests":[{"in":["\"banana\""],"out":"\"ana\""},{"in":["\"abcd\""],"out":"\"\""},{"in":["\"aa\""],"out":"\"a\""},{"in":["\"abcabcab\""],"out":"\"abcab\""},{"in":["\"nnpxouomcofdjuujloanjimymadkuepightrfodmauhrsy\""],"out":"\"ma\""},{"in":[],"out":"\"#1:af63a84c86019430\"","perf":{"label":"a 30,000-character string (length compared)","gen":"String a0 = BCB.str(30000, \"abcdefghijklmnopqrstuvwxyz\");","call":"Object r = s.longestDupSubstring(a0).length();"},"refMs":256}],"lesson":"string-matching"}
