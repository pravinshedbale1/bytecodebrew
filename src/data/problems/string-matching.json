{"slug":"rotate-string","title":"Rotate String","level":"Easy","summary":"Return whether s can become goal by repeatedly moving its first character to the end.","method":"rotateString","params":[["String","s"],["String","goal"]],"returns":"boolean","tests":[{"in":["\"abcde\"","\"cdeab\""],"out":"true"},{"in":["\"abcde\"","\"abced\""],"out":"false"},{"in":["\"a\"","\"a\""],"out":"true"},{"in":["\"aa\"","\"a\""],"out":"false"},{"in":["\"abab\"","\"baba\""],"out":"true"}],"lesson":"string-matching"},
