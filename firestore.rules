rules_version = '2';

// ByteCodeBrew: each signed-in user owns users/{uid}/state/{name}, one document per synced store
// (see src/lib/syncedStore.js). Nobody can read or write anyone else's data, and nothing else
// in the database is accessible from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per synced store; keep in sync with every createSyncedStore({ name }) in src/.
    function stateNames() {
      return ['progress', 'solved', 'stories', 'drills', 'highlights',
              'activity', 'quiz', 'practice', 'reviews', 'mocks', 'profile'];
    }

    function validState() {
      let d = request.resource.data;
      return d.keys().hasOnly(['json', 'updatedAt'])
        && d.json is string
        && d.json.size() <= 900000          // stay well under Firestore's 1 MiB document limit
        && d.updatedAt == request.time;     // must be serverTimestamp()
    }

    match /users/{uid}/state/{name} {
      allow read: if isOwner(uid)
        && name in stateNames();
      allow write: if isOwner(uid)
        && name in stateNames()
        && validState();
      allow delete: if isOwner(uid);
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
