rules_version = '2';

// ByteCodeBrew security rules.
//
//  users/{uid}/state/{name}   one document per synced store (src/lib/syncedStore.js). Each user reads and
//                             writes only their own; the admin can read them (view-as and analytics), never write. Premium stores accept writes only from premium accounts.
//  users/{uid}/private/settings  { claudeKey }: the learner's own Claude API key (src/lib/claude.js); only
//                             that account can read or write it, and it is never exported or shown to the admin.
//  users/{uid}/submissions/{slug}  code submissions on one practice problem (src/lib/submissions.js), same
//                             { json, updatedAt } shape; solving with tests is premium, so writes are too.
//  entitlements/{email}       premium access, one document per Google account email (lower case), granted
//                             by the admin or by a payment (with an optional expiresAt). Users read their own.
//  plans/{planId}             premium plans and prices, public, edited by the admin.
//  settings/sales             { open, message }: the admin pauses new purchases; public so /premium can say so.
//  orders/{orderId}           Cashfree payments, written by the payments Worker; buyers read their own.
//
// Keep the lists below in sync with src/config/access.js (ADMIN_EMAILS, PREMIUM_STORES).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return verifiedEmail() in ['bytecodebrew@gmail.com'];
    }

    function entitlementPath() {
      return /databases/$(database)/documents/entitlements/$(verifiedEmail());
    }

    // Premium: the admin, or an entitlement that is switched on and not expired
    function isPremium() {
      return isAdmin()
        || (verifiedEmail() != ''
            && exists(entitlementPath())
            && get(entitlementPath()).data.premium == true
            && (!('expiresAt' in get(entitlementPath()).data) || get(entitlementPath()).data.expiresAt > request.time));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Free for every signed-in user: reading progress, highlights, lesson quizzes and practice.
    // 'reset' is the marker "Delete my data" leaves, so other devices wipe their copy instead of re-uploading it.
    function freeNames() {
      return ['progress', 'solved', 'highlights', 'quiz', 'practice', 'activity', 'reset'];
    }

    // Premium: review deck, mock interviews, study plan + LeetCode profile, behavioral drill, story bank, Daily Coach, Climb.
    function premiumNames() {
      return ['reviews', 'mocks', 'profile', 'drills', 'stories', 'runway', 'coach', 'climb'];
    }

    function validState() {
      let d = request.resource.data;
      return d.keys().hasOnly(['json', 'updatedAt'])
        && d.json is string
        && d.json.size() <= 900000          // stay well under Firestore's 1 MiB document limit
        && d.updatedAt == request.time;     // must be serverTimestamp()
    }

    // The admin may READ a learner's learning data ("view as" on /admin and usage analytics); only the
    // learner can ever write it. The private settings document (API key) is never readable by the admin.
    match /users/{uid}/state/{name} {
      allow read: if (isOwner(uid) || isAdmin()) && (name in freeNames() || name in premiumNames());
      allow write: if isOwner(uid) && validState()
        && (name in freeNames() || (name in premiumNames() && isPremium()));
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/private/{name} {
      allow read, delete: if isOwner(uid) && name == 'settings';
      allow create, update: if isOwner(uid) && name == 'settings'
        && request.resource.data.keys().hasOnly(['claudeKey', 'updatedAt'])
        && request.resource.data.claudeKey is string
        && request.resource.data.claudeKey.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid}/submissions/{slug} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && slug.size() <= 120 && validState() && isPremium();
    }

    match /entitlements/{email} {
      allow read: if isAdmin() || (verifiedEmail() != '' && verifiedEmail() == email);
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['premium', 'note', 'addedAt', 'addedBy'])
        && request.resource.data.premium == true
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin();
    }

    // Plans and prices: public, set by the admin. The payments Worker reads the price from here.
    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && planId.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['name', 'price', 'durationDays', 'active', 'description', 'order', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.price is number && request.resource.data.price >= 1 && request.resource.data.price <= 1000000
        && request.resource.data.durationDays is int && request.resource.data.durationDays >= 0 && request.resource.data.durationDays <= 3650
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Sales switch: anyone may read it (the /premium page explains a pause); only the admin sets it.
    match /settings/{name} {
      allow read: if true;
      allow create, update: if isAdmin() && name == 'sales'
        && request.resource.data.keys().hasOnly(['open', 'message', 'updatedAt', 'updatedBy'])
        && request.resource.data.open is bool
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    // Payment orders: written only by the payments Worker (service account); buyers read their own.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Admin analytics: one query over every learner's state documents (collection group), read-only.
    match /{path=**}/state/{name} {
      allow read: if isAdmin();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
